################################################################################
# TEST REQUESTS - GET OPERATIONS
################################################################################

### Get all orders
GET {{baseUrl}}/orders
Content-Type: application/json

### Get single order
GET {{baseUrl}}/orders/1
Content-Type: application/json

### Get order #2
GET {{baseUrl}}/orders/2
Content-Type: application/json

################################################################################
# TEST REQUESTS - VALIDATION ERRORS (These should fail)
################################################################################

### FAIL: Negative amount
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customerName": "Invalid Order",
  "amount": -50
}

### FAIL: Zero amount
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customerName": "Invalid Order",
  "amount": 0
}

### FAIL: Empty customer name
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customerName": "",
  "amount": 99.99
}

### FAIL: Null customer name
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customerName": null,
  "amount": 99.99
}

################################################################################
# TEST REQUESTS - UPDATE OPERATIONS (PUT)
################################################################################

### UPDATE: Mark order as Completed
PUT {{baseUrl}}/orders/1
Content-Type: application/json

{
  "status": "Completed"
}

### UPDATE: Mark order as Cancelled
PUT {{baseUrl}}/orders/2
Content-Type: application/json

{
  "status": "Cancelled"
}

### UPDATE: Mark order back to Pending
PUT {{baseUrl}}/orders/3
Content-Type: application/json

{
  "status": "Pending"
}

################################################################################
# TEST REQUESTS - DELETE OPERATIONS
################################################################################

### DELETE: Remove order by ID
DELETE {{baseUrl}}/orders/5
Content-Type: application/json

################################################################################
# ERROR HANDLING - NOT FOUND (404)
################################################################################

### ERROR: Try to get non-existent order
GET {{baseUrl}}/orders/999
Content-Type: application/json

### ERROR: Try to update non-existent order
PUT {{baseUrl}}/orders/999
Content-Type: application/json

{
  "status": "Completed"
}

### ERROR: Try to delete non-existent order
DELETE {{baseUrl}}/orders/999
Content-Type: application/json

################################################################################
# QUICK TEST SEQUENCE
################################################################################
# 1. Run all SEED requests first to populate database
# 2. Run GET all orders to see data
# 3. Run UPDATE requests to change status
# 4. Run DELETE to remove an order
# 5. Run ERROR requests to test validation
################################################################################
